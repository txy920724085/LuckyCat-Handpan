// Separate ADS8688 + audio + QT2120 bend build. Existing CST is unchanged.
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC "reset_n" K16;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "dac_bclk" E22;
IO_LOC "dac_ws" F24;
IO_LOC "dac_data" G24;
IO_LOC "pa_en" H17;
IO_PORT "dac_bclk" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "dac_ws" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "dac_data" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "uart_rx_pin" N16;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx_pin" P15;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "ads_cs_n" T25;
IO_LOC "ads_sclk" W23;
IO_LOC "ads_sdi" T23;
IO_LOC "ads_sdo" P25;
IO_LOC "ads_rst_n" R23;
IO_LOC "ads_daisy" R25;
IO_PORT "ads_cs_n" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "ads_sclk" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "ads_sdi" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "ads_sdo" IO_TYPE=LVCMOS33;
IO_PORT "ads_rst_n" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "ads_daisy" IO_TYPE=LVCMOS33 DRIVE=4;
// Confirmed teammate candidate mapping; real wiring and 3.3V pull-ups still apply.
IO_LOC "qt_scl" H14;
IO_LOC "qt_sda" L17;
IO_PORT "qt_scl" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "qt_sda" IO_TYPE=LVCMOS33 DRIVE=4;
// Additional, independent JDY channel; legacy P15/N16 above are unchanged.
// Verified wave-JDY Device B route: H15 -> J24-6 -> JDY RX, L18 <- J24-8 <- JDY TX.
IO_LOC "jdy_tx_pin" H15;
IO_PORT "jdy_tx_pin" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "jdy_rx_pin" L18;
IO_PORT "jdy_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;

CLOCK_LOC "clk_d" BUFG = CLK;
IO_LOC "tmds_d_p[0]" AB24,AC24;
IO_LOC "tmds_d_p[1]" V24,W24;
IO_LOC "tmds_d_p[2]" AA22,AA23;
IO_LOC "tmds_clk_p" Y22,Y23;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "led_n[0]" J14;
IO_LOC "led_n[1]" R26;
IO_LOC "led_n[2]" L20;
IO_LOC "led_n[3]" M25;
IO_LOC "led_n[4]" N21;
IO_LOC "led_n[5]" N23;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE;
